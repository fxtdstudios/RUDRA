ocio_profile_version: 2

description: RUDRA delivery working spaces (pair with the official ACES OCIO config for display transforms)
name: rudra-delivery

roles:
  scene_linear: RUDRA Scene Linear (Rec.2020)
  aces_interchange: ACES2065-1
  default: RUDRA Scene Linear (Rec.2020)
  data: Raw

file_rules:
  - !<Rule> {name: Default, colorspace: default}

colorspaces:
  - !<ColorSpace>
    name: ACES2065-1
    family: Scene
    encoding: scene-linear
    bitdepth: 32f
    description: SMPTE ST 2065-1 AP0 primaries, ACES white. Reference space.

  - !<ColorSpace>
    name: Raw
    family: Utility
    encoding: data
    isdata: true

  - !<ColorSpace>
    name: RUDRA Scene Linear (Rec.2020)
    family: Scene
    encoding: scene-linear
    bitdepth: 32f
    description: |
      Linear Rec.2020 to ACES2065-1 via Bradford CAT.
      Generated by rudra.delivery.aces; matrices derived from primaries, not copied.
    to_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.6790856347, 0.1577009146, 0.1632134506, 0.0000000000, 0.0460020031, 0.8590546730, 0.0949433239, 0.0000000000, -0.0005739432, 0.0284677684, 0.9721061748, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000]}
  - !<ColorSpace>
    name: Linear Rec.709
    family: Scene
    encoding: scene-linear
    bitdepth: 32f
    description: |
      Linear Linear Rec.709 to ACES2065-1 via Bradford CAT.
      Generated by rudra.delivery.aces; matrices derived from primaries, not copied.
    to_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.4396329819, 0.3829886982, 0.1773783199, 0.0000000000, 0.0897764430, 0.8134394287, 0.0967841283, 0.0000000000, 0.0175411704, 0.1115465533, 0.8709122763, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000]}
  - !<ColorSpace>
    name: ACEScg
    family: Scene
    encoding: scene-linear
    bitdepth: 32f
    description: |
      Linear ACEScg to ACES2065-1 via Bradford CAT.
      Generated by rudra.delivery.aces; matrices derived from primaries, not copied.
    to_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.6954522414, 0.1406786965, 0.1638690622, 0.0000000000, 0.0447945634, 0.8596711185, 0.0955343182, 0.0000000000, -0.0055258826, 0.0040252103, 1.0015006723, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000]}
