/* RUDRA Studio in Qt Widgets: ui/theme.css (over ui/style.css) rule by rule.

   Colours come only from ui/theme.css: its tokens by name, and the literal
   greys the page's own rules use (the menubar #232323, the hover ink
   #e6e6e6). native/tests/test_theme.cpp holds every colour here to that, and
   every grey to R = G = B; where style.css still has a tinted grey theme.css
   did not reach (the scrub track, the check tick), the theme's neutral or its
   active ink stands in. The page's 10.5px sizes are 11px here and 9.5px are
   10px: a Qt font has whole pixel sizes. Sizes the layout fixes (the rails,
   the rows) are set in app/layout.cpp, not here: a QSS min-width counts the
   content only, the page's boxes include their border.

   A page class is the dynamic property "role" on a widget (.plabel is
   [role="plabel"]), and a page id is the widget's object name. */

QWidget {
  font-family: "var(--ui-family)";
  background: var(--bg);
  color: var(--ink);
  font-size: 11px;
  font-weight: 500;
  selection-background-color: var(--accent-dim);
  selection-color: #dceaf5;
}

QMainWindow, QMainWindow::separator { background: var(--bg); }
QMainWindow::separator { width: 1px; height: 1px; background: #000; }
QSplitter::handle { background: #000; }

/* ── menubar: one 30px row with the lockup and the machine state ───── */
QMenuBar { background: #232323; border-bottom: 1px solid #000; padding: 0 2px; font-size: 12px; }
QMenuBar::item { background: transparent; color: #9a9a9a; padding: 4px 9px; border-radius: var(--radius); }
QMenuBar::item:selected, QMenuBar::item:pressed { background: var(--raise); color: #e6e6e6; }
QWidget[role="lockup"] { background: transparent; border-right: 1px solid var(--line); }
QLabel[role="lk-name"] { background: transparent; color: #e6e6e6; font-size: 13px; font-weight: 700; }
QWidget[role="mstat"] { background: transparent; }
QWidget[role="mstat"] QLabel { background: transparent; }
QLabel[role="pill"] { font-family: "var(--mono-family)"; font-size: 11px; color: #a8a8a8; }
QLabel[role="lamp"] { background: #4a4a4a; border-radius: 3px; }
QLabel[role="lamp"][state="on"] { background: var(--ok); }
QLabel[role="studiomark"] { color: #5e5e5e; font-size: 10px; font-weight: 600; padding-left: 14px; border-left: 1px solid var(--line); }
QWidget#wsswitch QPushButton { padding: 2px 8px; font-size: 11px; background: var(--raise); color: #9a9a9a; border: 1px solid var(--line-2); border-radius: 0; }
QWidget#wsswitch QPushButton:checked { background: var(--accent-dim); color: #dceaf5; }

QMenu { background: var(--panel); border: 1px solid var(--line-2); padding: 3px 0; font-size: 12px; }
QMenu::item { padding: 4px 22px 4px 18px; color: var(--ink); background: transparent; }
QMenu::item:selected { background: var(--accent-dim); color: #dceaf5; }
QMenu::item:disabled { color: var(--ink-3); }
QMenu::separator { height: 1px; background: var(--line); margin: 3px 0; }
QMenu::indicator { width: 10px; height: 10px; left: 5px; }
QMenu::indicator:checked { background: var(--accent); border: 1px solid var(--accent-line); }

/* ── the frame ─────────────────────────────────────────────────────── */
QWidget#app, QWidget#body { background: var(--bg); }
QWidget#iconRail { background: #1b1b1b; border-right: 1px solid #000; }
QWidget#iconRail QToolButton { background: transparent; border: 0; border-radius: var(--radius); }
QWidget#iconRail QToolButton:hover { background: var(--raise); }
QWidget#railLeft { background: var(--panel); border-right: 1px solid #000; }
QWidget#railRight { background: var(--panel); border-left: 1px solid #000; }
QScrollArea#railscroll, QWidget#railColumn { background: var(--panel); border: 0; }
QWidget#centre { background: var(--bg); }

/* ── panel labels ──────────────────────────────────────────────────── */
QWidget[role="plabel"] { background: #232323; border-bottom: 1px solid var(--line); }
QLabel[role="plabel-text"] { background: transparent; color: #8e8e8e; font-size: 11px; font-weight: 600; }
QLabel[role="note"] { background: transparent; color: var(--ink-3); font-family: "var(--mono-family)"; font-size: 10px; }
QLabel[role="note-p"] { background: transparent; color: var(--ink-3); font-size: 11px; }
QLabel[role="key"] { background: transparent; color: var(--ink-3); }
QLabel[role="value"] { background: transparent; font-family: "var(--mono-family)"; color: #bdbdbd; }
QLabel[role="value"][state="warn"] { color: var(--gold); }
QLabel[role="value"][state="clip"] { color: var(--bad); }
QLabel[role="unit"] { background: transparent; color: var(--ink-3); font-size: 10px; }
QWidget[role="prow"] { background: transparent; border-top: 1px solid #212121; }
QWidget[role="field"], QWidget[role="ctl"], QWidget[role="slider"] { background: transparent; }
QWidget[role="field"] QLabel[role="value"] { color: var(--ink); font-size: 11px; }

/* ── the media rail ────────────────────────────────────────────────── */
QFrame#dropzone { border: 1px dashed var(--line-2); border-radius: var(--radius); background: transparent; }
QFrame#dropzone QLabel { background: transparent; color: var(--ink-3); font-size: 11px; }
QFrame#dropzone[state="hot"] { border-color: var(--accent); }
QFrame#dropzone[state="hot"] QLabel { color: var(--ink-2); }
QLabel[role="drop-b"] { color: var(--ink-2); font-size: 12px; }
QLabel[role="drop-or"] { font-size: 10px; }
QLabel[role="empty-rail"] { background: transparent; color: var(--ink-3); font-size: 11px; padding: 10px 11px; }
QLabel[role="seq-note"] { background: transparent; color: var(--ink-3); font-size: 11px; padding: 0 10px 6px; }
QWidget[role="shot-head"] { background: transparent; border-bottom: 1px solid var(--line); }
QWidget[role="shot-head"] QLabel { background: transparent; color: var(--ink-3); font-size: 10px; font-weight: 600; }

/* ── the probe readout ─────────────────────────────────────────────── */
QWidget[role="probepanel"] { background: var(--panel-2); border-top: 1px solid #000; }
QWidget#probePanel, QWidget#probePanel QWidget { background: transparent; }
QLabel#probeNits { background: transparent; font-family: "var(--mono-family)"; font-size: 32px; color: #ededed; }
QLabel#probeNits[state="idle"] { font-size: 15px; color: var(--ink-3); }
QLabel#probeNitsUnit { background: transparent; color: var(--ink-2); font-size: 12px; font-weight: 400; }
QLabel#probeDelta { background: transparent; font-family: "var(--mono-family)"; color: var(--gold); }
QLabel#probeDelta[state="idle"] { color: var(--ink-3); }

/* ── scopes and frame stats ────────────────────────────────────────── */
QWidget#scopes { background: var(--panel); border-bottom: 1px solid #000; }
QWidget[role="plot"] { background: #0e0e0e; }
QWidget[role="plot-area"] { background: #0a0a0a; border: 1px solid #242424; }
QWidget#frameStats { background: var(--panel-2); border-top: 1px solid #000; }
QWidget[role="ms"] { background: transparent; }
QWidget#clipBar { background: #242424; border-radius: 1px; }

/* ── viewer, its toolbar and the transport ─────────────────────────── */
QStackedWidget#viewer, QWidget#empty { background: var(--bg); }
QWidget#empty QLabel { background: transparent; color: var(--ink-3); font-size: 11px; }
QLabel[role="empty-b"] { color: var(--ink-2); font-size: 13px; }
QWidget#viewerTools { background: #1d1d1d; border-bottom: 1px solid #000; }
QWidget#viewerTools QLabel { background: transparent; }
QLabel[role="vlabel"] { color: var(--ink-3); font-size: 10px; font-weight: 600; }
QLabel[role="vstatic"] { color: var(--ink-2); font-size: 11px; font-family: "var(--mono-family)"; }
QWidget[role="vsep"] { background: var(--line); min-width: 1px; max-width: 1px; min-height: 15px; max-height: 15px; }
QWidget#transport { background: #232323; border-top: 1px solid #000; }
QWidget#transport QLabel { background: transparent; }
QLabel#tc { font-family: "var(--mono-family)"; font-size: 15px; color: #e4e4e4; }
QLabel#srcInfo { font-family: "var(--mono-family)"; font-size: 10px; color: var(--ink-3); }
QWidget#scrub { background: transparent; }
QWidget#transport QToolButton { background: var(--raise); border: 1px solid var(--line-2); border-radius: 0; }
QWidget#transport QToolButton:disabled { background: var(--panel); }

/* ── the colour pipeline bar ───────────────────────────────────────── */
QWidget#pipe { background: #101010; border-top: 1px solid #000; }
QWidget#pipe QWidget, QWidget#pipe QLabel { background: transparent; color: #a5a5a5; }
QLabel[role="pipe-em"] { color: #565656; font-size: 10px; }
QLabel[role="pipe-b"] { color: #d2d2d2; font-family: "var(--mono-family)"; font-size: 11px; }
QLabel[role="pipe-arrow"] { color: #4a4a4a; font-size: 10px; }
QLabel[role="pipe-s"] { color: var(--ink-3); font-family: "var(--mono-family)"; font-size: 11px; }
QWidget[role="vrule"] { background: var(--line); }
QLabel#pipeWarn { color: var(--gold); font-family: "var(--mono-family)"; }

/* ── buttons: the page's .tbtn and .seg ────────────────────────────── */
QPushButton, QToolButton {
  background: var(--raise);
  color: #9a9a9a;
  border: 1px solid var(--line-2);
  border-radius: var(--radius);
  padding: 3px 9px;
  font-size: 11px;
}
QPushButton:hover, QToolButton:hover { color: #e6e6e6; }
QPushButton:checked, QToolButton:checked { background: var(--accent-dim); border-color: var(--accent-line); color: #dceaf5; }
QPushButton[role="primary"] { background: var(--accent-dim); border-color: var(--accent-line); color: #dceaf5; }
QPushButton:disabled, QToolButton:disabled { color: var(--ink-3); background: var(--panel); }
QToolButton::menu-indicator { image: none; width: 0; }
QWidget[role="seg"] { background: transparent; }
QWidget[role="seg"] QPushButton { border-radius: 0; padding: 3px 9px; }
QWidget[role="seg"] QPushButton:checked { background: var(--accent-dim); border-color: var(--line-2); color: #dceaf5; }
QWidget#actions { background: var(--panel); border-top: 1px solid var(--line); }
QWidget#actions QPushButton { padding: 5px 9px; }

/* ── the inspector tabs: the page's .itabs ─────────────────────────── */
QWidget#itabs { background: var(--panel); border-bottom: 1px solid var(--line); }
QWidget#itabs QPushButton { background: transparent; border: 0; border-bottom: 2px solid transparent; border-radius: 0; color: var(--ink-3); padding: 6px 4px; }
QWidget#itabs QPushButton:checked { background: var(--panel-2); color: var(--ink); border-bottom: 2px solid var(--accent); }
QWidget#itabs QPushButton:hover { color: var(--ink-2); }
QStackedWidget#ipanels, QStackedWidget#ipanels > QWidget { background: var(--panel); }

/* ── check rows ────────────────────────────────────────────────────── */
QWidget[role="check"] { background: transparent; }
QLabel[role="check-lab"] { background: transparent; color: var(--ink-2); font-size: 11px; }
QWidget[role="check"][on="true"] QLabel[role="check-lab"] { color: var(--ink); }
QLabel[role="check-hint"] { background: transparent; color: var(--ink-3); font-family: "var(--mono-family)"; font-size: 10px; }

/* ── sliders: a hairline track and a square key ────────────────────── */
QSlider { background: transparent; min-height: 17px; }
QSlider::groove:horizontal { height: 3px; background: #2a2a2a; border-radius: 1px; }
QSlider::sub-page:horizontal, QSlider::add-page:horizontal { background: #2a2a2a; border-radius: 1px; }
QSlider::handle:horizontal { width: 9px; height: 15px; margin: -6px 0; background: #a2b8c7; border: 1px solid #141414; border-radius: 1px; }
QSlider::handle:horizontal:focus { border-color: var(--accent); }
QLabel[role="slider-lab"] { background: transparent; color: #a8a8a8; }
QLabel[role="slider-val"] { background: transparent; color: #c4c4c4; font-family: "var(--mono-family)"; }

/* ── text fields, combos, spin boxes ───────────────────────────────── */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
  background: var(--panel-2);
  color: var(--ink);
  border: 1px solid var(--line-2);
  border-radius: var(--radius);
  padding: 2px 5px;
}
QLineEdit { font-family: "var(--mono-family)"; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: var(--accent-line); }
QComboBox::drop-down { border: 0; width: 14px; }
QComboBox QAbstractItemView { background: var(--panel); border: 1px solid var(--line-2); selection-background-color: var(--accent-dim); }
QLabel[role="small"], QLabel[role="render-status"] { background: transparent; color: var(--ink-3); font-size: 10px; }
QWidget[role="ctl"] QLabel { background: transparent; }
QPlainTextEdit#log { font-family: "var(--mono-family)"; font-size: 11px; color: var(--ink-2); background: var(--panel-2); border: 0; }

/* ── lists, scroll bars ────────────────────────────────────────────── */
QListView, QListWidget, QTreeView { background: var(--panel); border: 0; outline: 0; }
QListView::item:selected, QListWidget::item:selected, QTreeView::item:selected { background: var(--accent-dim); color: #dceaf5; }
QScrollBar:vertical { background: var(--panel-2); width: 9px; margin: 0; }
QScrollBar:horizontal { background: var(--panel-2); height: 9px; margin: 0; }
QScrollBar::handle { background: var(--raise); border-radius: 1px; min-height: 20px; min-width: 20px; }
QScrollBar::handle:hover { background: var(--line-2); }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ── sheets and tool tips ──────────────────────────────────────────── */
QDialog#sheet { background: var(--panel); border: 1px solid var(--line); }
QDialog#sheet QLabel { background: transparent; }
QToolTip { background: var(--panel); color: var(--ink); border: 1px solid var(--line); padding: 3px 5px; }

/* ── the Region EV editor: the page's .region rows ─────────────────── */
QWidget#regions { background: transparent; }
QWidget[role="region"] { background: transparent; border-radius: var(--radius); }
QWidget[role="region"]:hover { background: var(--panel-2); }
QWidget[role="region"][sel="true"] { background: var(--raise); }
QWidget[role="region"] QLabel { background: transparent; }
QLabel[role="region-q"] { font-family: "var(--mono-family)"; font-size: 11px; color: var(--ink-2); }
QLabel[role="region-ev"] { font-family: "var(--mono-family)"; font-size: 11px; color: var(--ink-3); padding: 1px 3px; border-radius: var(--radius); }
QLabel[role="region-ev"]:hover { background: var(--raise); color: var(--ink); }
QLabel[role="region-ev"][live="true"] { color: var(--ok); }
QLabel[role="region-u"] { font-family: "var(--mono-family)"; font-size: 10px; color: var(--ink-3); }

/* ── the frame stats rows, the clip bar, the probe box ─────────────── */
QWidget[role="ro"] { background: transparent; }
QLabel[role="value"][state="hi"] { color: var(--gold); }
QLabel[role="value"][state="bad"] { color: var(--bad); }
QWidget#clipBar { background: #242424; border-radius: 1px; }
QWidget#clipLost { background: var(--bad); }
QWidget#clipActed { background: #6b5436; }
QFrame#probeBox { background: var(--panel-2); border: 1px solid var(--line); }
QFrame#probeBox QLabel { background: transparent; font-family: "var(--mono-family)"; font-size: 11px; }
QLabel#probeSrc[state="clip"] { color: var(--bad); }
QLabel#probeModel[state="hi"] { color: var(--gold); }
