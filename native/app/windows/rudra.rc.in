// RUDRA.exe's icon and version, filled in by CMake (app/CMakeLists.txt).
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/icons/rudra.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FXTD Studios"
            VALUE "FileDescription", "RUDRA: SDR to HDR reconstruction"
            VALUE "FileVersion", "@RUDRA_VERSION_LABEL@"
            VALUE "InternalName", "RUDRA"
            VALUE "LegalCopyright", "Copyright 2026 FXTD Studios. PolyForm Noncommercial 1.0.0."
            VALUE "OriginalFilename", "RUDRA.exe"
            VALUE "ProductName", "RUDRA"
            VALUE "ProductVersion", "@RUDRA_VERSION_LABEL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
