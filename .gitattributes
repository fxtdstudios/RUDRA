# Line endings are normalised to LF in the repository, whatever the checkout
# does locally. Without this, a Windows editor saving a file it did not really
# change rewrites every line, and the diff reads as a full-file rewrite: on
# 28 Aug 2026 the GitHub-authored workflow file showed 34 insertions and 34
# deletions with no content change at all.
* text=auto

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.exr  binary
*.tif  binary
*.tiff binary
*.pdf  binary
*.safetensors binary
*.pt   binary
*.pth  binary
*.ckpt binary
*.npz  binary
*.ttf  binary
*.otf  binary

# Batch files are run by cmd.exe and want CRLF. Shell scripts must never have
# it: a CRLF shebang line makes the kernel look for an interpreter that does
# not exist, and the error names a file that is plainly there.
*.bat  text eol=crlf
*.sh   text eol=lf

# Golden files are compared byte for byte by the native tests, and the queue
# golden records the SHA-256 of its queue.json. A CRLF checkout on Windows
# would change every one of them, so they are stored and checked out as-is.
native/tests/golden/** -text
